# Variaveis do app Expo. Todas sao EXPO_PUBLIC_*: viram parte do bundle do APK,
# entao NAO servem para segredo — o que for secreto fica na API.
#
# O .env de verdade e ignorado pelo git (regra da raiz). Copie este arquivo para
# .env e preencha.

# API do Ta Barato, com o /api no fim
EXPO_PUBLIC_API_URL=https://api-production-b730d.up.railway.app/api

# Chave PUBLICA do Mercado Pago (public key, nao o access token)
EXPO_PUBLIC_MP_PUBLIC_KEY=

# Client ID web do Google, usado no login social
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Site da plataforma — usado nos links de Termos e Privacidade.
# Trocar para https://tabaratoapp.com.br quando o DNS propagar.
EXPO_PUBLIC_WEB_URL=
